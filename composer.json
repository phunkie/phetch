{
    "name": "phunkie/phetch",
    "description": "A functional database library for PHP inspired by Scala's Slick.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Marcello Duarte",
            "email": "marcello.duarte@gmail.com"
        }
    ],
    "bin": [
        "bin/phetch"
    ],
    "require": {
        "php": "^8.2 || ^8.3 || ^8.4",
        "phunkie/phunkie": "^1.5",
        "phunkie/effect": "^1.3",
        "phunkie/streams": "^1.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.0",
        "friendsofphp/php-cs-fixer": "^3.0",
        "phunkie/phpstan": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Phunkie\\Phetch\\": "src/"
        },
        "files": [
            "src/Functions/connection.php",
            "src/Functions/query.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "cs-fix": "php-cs-fixer fix --allow-risky=yes",
        "cs-check": "php-cs-fixer fix --dry-run --diff --allow-risky=yes",
        "phpstan": "phpstan analyse --memory-limit=512M",
        "lint": [
            "@cs-check",
            "@phpstan"
        ],
        "check": [
            "@lint",
            "@test"
        ]
    }
}
