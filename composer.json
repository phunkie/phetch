{
    "name": "phunkie/phetch",
    "description": "A functional database library for PHP inspired by Scala's Slick.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Marcello Duarte",
            "email": "marcello.duarte@gmail.com"
        }
    ],
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/phunkie/phunkie.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/phunkie/effect.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/phunkie/streams.git"
        }
    ],
    "bin": [
        "bin/phetch"
    ],
    "require": {
        "php": "^8.2 || ^8.3 || ^8.4",
        "phunkie/phunkie": "dev-developing-1.1.0",
        "phunkie/effect": "dev-developing-1.2.0",
        "phunkie/streams": "dev-developing-1.1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.0",
        "friendsofphp/php-cs-fixer": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Phunkie\\Phetch\\": "src/"
        },
        "files": [
            "src/Functions/connection.php",
            "src/Functions/query.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}